// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName               String
  lastName                String
  email                   String    @unique @db.Citext
  name                    String    @default("")
  emailVerified           Boolean   @default(false)
  image                   String?
  role                    String    @default("user")
  banned                  Boolean   @default(false)
  banReason               String?
  banExpires              DateTime?
  picture                 String?
  deactivatedAt           DateTime?
  sessions                Session[]
  accounts                Account[]
  createdInvites          Invite[]  @relation("CreatedByUser")
  acceptedInvites         Invite[]  @relation("AcceptedByUser")
  revokedInvites          Invite[]  @relation("RevokedByUser")
  updatedAt               DateTime  @updatedAt
  createdAt               DateTime  @default(now())
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  token          String   @unique
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                     String    @id @default(uuid()) @db.Uuid
  accountId              String
  providerId             String
  userId                 String    @db.Uuid
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  password               String?
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @unique
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Invite {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName               String
  lastName                String?
  email                   String    @db.Citext
  message                 String?
  updatedAt               DateTime  @updatedAt
  createdAt               DateTime  @default(now())
  createdBy               User      @relation("CreatedByUser", fields: [createdById], references: [id])
  createdById             String    @db.Uuid
  acceptedAt              DateTime?
  acceptedBy              User?     @relation("AcceptedByUser", fields: [acceptedById], references: [id])
  acceptedById            String?   @db.Uuid
  revokedAt               DateTime?
  revokedBy               User?     @relation("RevokedByUser", fields: [revokedById], references: [id])
  revokedById             String?   @db.Uuid
}
